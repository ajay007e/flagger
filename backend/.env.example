# Environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# MySQL connection (matches docker-compose.yml defaults)
DATABASE_URL="mysql://flagger:flagger@localhost:3306/flagger"

# Shadow database for Prisma migrate dev (read by the Prisma CLI, not by the app)
SHADOW_DATABASE_URL="mysql://flagger:flagger@localhost:3306/flagger_shadow"

# Redis connection (matches docker-compose.yml defaults)
REDIS_URL="redis://localhost:6379"

# Secret used to sign session cookies. At least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="change-me-use-openssl-rand-hex-32-to-generate"

# Comma-separated frontend origins allowed by CORS (no path, no trailing slash)
ALLOWED_ORIGINS="http://localhost:3000"

# Key required to create the first admin. At least 32 characters.
# Generate one with: openssl rand -hex 32
SETUP_API_KEY="change-me-use-openssl-rand-hex-32-to-generate"
