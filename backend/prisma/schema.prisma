generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

model SystemSetting {
  key       String    @id @map("setting_key") @db.VarChar(100)
  value     Json
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  updatedByUser User? @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

enum UserType {
  admin
  user
}

model User {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  email    String @unique @db.VarChar(255)
  name     String @db.VarChar(255)
  password String @db.VarChar(255)

  type     UserType @default(user)
  isActive Boolean  @default(true) @map("is_active")

  mustChangePassword Boolean @default(false) @map("must_change_password")

  sessionVersion Int @default(1) @map("session_version")

  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  updatedByUser User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedUsers  User[] @relation("UserUpdatedBy")

  updatedSystemSettings SystemSetting[] @relation("SystemSettingUpdatedBy")
  updatedEnvironments   Environment[]   @relation("EnvironmentUpdatedBy")
  updatedProjects       Project[]       @relation("ProjectUpdatedBy")
  updatedEntities       Entity[]        @relation("EntityUpdatedBy")
  updatedRoles          Role[]          @relation("RoleUpdatedBy")

  @@map("users")
}

enum AuditActorType {
  user
  api_key
  system
}

enum AuditOutcome {
  success
  failure
}

model AuditLog {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  eventId String? @unique @map("event_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actorType AuditActorType @map("actor_type")
  actorId   Int?           @map("actor_id") @db.UnsignedInt

  action String @db.VarChar(100)

  resourceType String  @map("resource_type") @db.VarChar(100)
  resourceId   String? @map("resource_id") @db.VarChar(191)

  projectId     Int? @map("project_id") @db.UnsignedInt
  entityId      Int? @map("entity_id") @db.UnsignedInt
  environmentId Int? @map("environment_id") @db.UnsignedInt

  outcome AuditOutcome @default(success)

  before   Json?
  after    Json?
  metadata Json?

  requestId String  @map("request_id") @db.Char(36)
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorType, actorId, action, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_logs")
}

model Environment {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  key         String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  sortOrder   Int     @default(0) @map("sort_order")

  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  updatedByUser User? @relation("EnvironmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([sortOrder])
  @@map("environments")
}

model Project {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  key         String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  updatedByUser User? @relation("ProjectUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  entities Entity[]

  @@map("projects")
}

model Entity {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  projectId Int @map("project_id") @db.UnsignedInt

  key         String  @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  updatedByUser User?   @relation("EntityUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([projectId, key])
  @@map("entities")
}

model Role {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  key         String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  updatedByUser User?            @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  permissions   RolePermission[]

  @@map("roles")
}

model RolePermission {
  roleId     Int    @map("role_id") @db.UnsignedInt
  permission String @db.VarChar(50)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}
